# SpiritOS Backup System v0.1 example config.
# Copy only after operator approval. Keep real values out of git.

SPIRIT_BACKUP_MODE=dry-run
SPIRIT_BACKUP_I_UNDERSTAND_REAL_WRITES=false

# Dell/source-server restic repository example.
RESTIC_REPOSITORY=/mnt/spirit-8tb/spiritos-backups/restic-repos/source-server
RESTIC_PASSWORD_FILE=REPLACE_ME_PATH_TO_OPERATOR_MANAGED_PASSWORD_FILE

# Mac mini support node restic repository example.
SPIRIT_MAC_RESTIC_REPOSITORY=/mnt/spirit-8tb/spiritos-backups/restic-repos/spirit-mac-mini
SPIRIT_MAC_HOST=spirit-mac-mini
SPIRIT_MAC_REPO_PATH=/Users/spiritmac/spiritos-worker/SpiritOS

# Windows desktop node restic repository example.
SPIRIT_WINDOWS_RESTIC_REPOSITORY=/mnt/spirit-8tb/spiritos-backups/restic-repos/spirit-windows
SPIRIT_WINDOWS_FS_ALLOWLIST=C:\\Projects

# Optional future mirror target. Do not enable without separate approval.
RCLONE_REMOTE=REPLACE_ME_DISABLED

# Retention examples only. v0.1 does not run prune/forget/delete.
# RESTIC_KEEP_DAILY=7
# RESTIC_KEEP_WEEKLY=4
# RESTIC_KEEP_MONTHLY=12
