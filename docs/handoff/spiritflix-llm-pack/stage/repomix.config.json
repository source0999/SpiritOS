{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": { "maxFileSize": 2000000 },
  "output": {
    "style": "xml",
    "parsableStyle": true,
    "compress": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "truncateBase64": true,
    "topFilesLength": 20,
    "git": { "sortByChanges": false, "includeDiffs": false, "includeLogs": false }
  },
  "include": ["**/*"],
  "ignore": { "useGitignore": false, "useDotIgnore": false, "useDefaultPatterns": true, "customPatterns": ["repomix.config.json"] },
  "security": { "enableSecurityCheck": false },
  "tokenCount": { "encoding": "o200k_base" }
}
