{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-proxy.model-visible-packet/v1",
  "title": "Campaign 2-J Model-Visible Packet Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "lane",
    "model",
    "model_registry_id",
    "model_digest",
    "provider_reported_models",
    "executor_version",
    "context_builder_version",
    "registry_attestation",
    "messages_or_prompts",
    "tool_contract",
    "backend_requests",
    "backend_request_bytes_base64",
    "backend_request_sha256",
    "role_order",
    "system_prompts",
    "user_prompts",
    "flattened_generate_prompts",
    "task_specification",
    "acceptance_criteria",
    "project_instruction_receipt",
    "stop_sequences",
    "generation_parameters",
    "context",
    "path_consistency",
    "tool_protocol",
    "response"
  ],
  "properties": {
    "schema_version": {"const": "source-proxy.model-visible-packet/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "model": {"enum": ["qwen2.5-coder:7b", "qwen2.5-coder:14b"]},
    "model_registry_id": {"enum": ["qwen2.5-coder:7b", "qwen2.5-coder:14b"]},
    "model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_reported_models": {"type": "array", "items": {"type": ["string", "null"]}},
    "jcode_binary_sha256": {"type": ["string", "null"]},
    "executor_version": {"type": "string"},
    "bridge_version": {"type": ["string", "null"]},
    "context_builder_version": {"type": "string"},
    "registry_attestation": {"type": "object"},
    "messages_or_prompts": {"type": "array", "items": {"type": "object"}},
    "tool_contract": {},
    "backend_requests": {"type": "array", "items": {"type": "object"}},
    "backend_request_bytes_base64": {"type": "array", "items": {"type": "string"}},
    "backend_request_sha256": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "role_order": {"type": "array", "items": {"type": "string"}},
    "system_prompts": {"type": "array", "items": {"type": "string"}},
    "user_prompts": {"type": "array", "items": {"type": "string"}},
    "flattened_generate_prompts": {"type": "array", "items": {"type": "string"}},
    "task_specification": {"type": "object"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "project_instruction_receipt": {"type": "object"},
    "stop_sequences": {"type": "array"},
    "generation_parameters": {"type": "array", "items": {"type": "object"}},
    "context": {"type": "object"},
    "path_consistency": {"type": "object"},
    "tool_protocol": {"type": "object"},
    "response": {"type": "object"}
  }
}
