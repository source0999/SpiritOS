<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>SpiritOS Windows backup dry-run example. APPROVAL REQUIRED before installing.</Description>
  </RegistrationInfo>
  <Actions Context="Author">
    <Exec>
      <Command>PowerShell</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File C:\Projects\SpiritOS\scripts\backups\spiritos-backup-windows.ps1 -DryRun</Arguments>
    </Exec>
  </Actions>
</Task>
