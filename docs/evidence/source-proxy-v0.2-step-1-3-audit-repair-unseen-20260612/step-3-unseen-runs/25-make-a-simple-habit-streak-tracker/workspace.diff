+}--- a/streak-tracker.html
+++ b/streak-tracker.html
@@ -0,0 +1,17 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Habit Streak Tracker</title>
+    <link rel="stylesheet" href="streak-tracker.css">
+</head>
+<body>
+    <div class="container">
+        <h1>Habit Streak Tracker</h1>
+        <p id="streak">Current Streak: 0 days</p>
+        <button id="trackButton">Track Habit</button>
+    </div>
+    <script src="streak-tracker.js"></script>
+</body>
+</html>--- a/streak-tracker.js
+++ b/streak-tracker.js
@@ -0,0 +1,12 @@
+let streak = 0;
+
+function updateStreak() {
+    document.getElementById('streak').textContent = `Current Streak: ${streak} days`;
+}
+
+document.getElementById('trackButton').addEventListener('click', () => {
+    streak++;
+    updateStreak();
+});
+
+updateStreak();