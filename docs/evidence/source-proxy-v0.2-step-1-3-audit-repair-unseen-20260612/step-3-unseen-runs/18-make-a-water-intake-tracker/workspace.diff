--- a/water_intake_tracker.css
+++ b/water_intake_tracker.css
@@ -0,0 +1,6 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#tracker {
+    margin-top: 20px;
+}--- a/water_intake_tracker.html
+++ b/water_intake_tracker.html
@@ -0,0 +1,16 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Water Intake Tracker</title>
+    <link rel="stylesheet" href="water_intake_tracker.css">
+</head>
+<body>
+    <h1>Water Intake Tracker</h1>
+    <input type="number" id="intakeAmount" placeholder="Intake Amount (ml)">
+    <button onclick="trackIntake()">Track Intake</button>
+    <div id="tracker"></div>
+    <script src="water_intake_tracker.js"></script>
+</body>
+</html>--- a/water_intake_tracker.js
+++ b/water_intake_tracker.js
@@ -0,0 +1,8 @@
+function trackIntake() {
+    const amount = document.getElementById('intakeAmount').value;
+    if (amount) {
+        const tracker = document.getElementById('tracker');
+        tracker.innerHTML += `<p>Drank ${amount} ml</p>`;
+        document.getElementById('intakeAmount').value = '';
+    }
+}