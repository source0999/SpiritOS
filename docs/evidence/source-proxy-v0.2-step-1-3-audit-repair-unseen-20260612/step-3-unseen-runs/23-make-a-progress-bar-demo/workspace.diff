--- a/progress-bar-demo.css
+++ b/progress-bar-demo.css
@@ -0,0 +1,18 @@
+.progress-container {
+    width: 100%;
+    margin-top: 20px;
+}
+
+.progress-bar {
+    height: 30px;
+    background-color: #ddd;
+    border-radius: 5px;
+    overflow: hidden;
+}
+
+.progress-bar-fill {
+    height: 100%;
+    background-color: #4caf50;
+    width: 0;
+    transition: width 0.2s ease-in-out;
+}--- a/progress-bar-demo.html
+++ b/progress-bar-demo.html
@@ -0,0 +1,16 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Progress Bar Demo</title>
+    <link rel="stylesheet" href="progress-bar-demo.css">
+</head>
+<body>
+    <div class="progress-container">
+        <div id="progress-bar" class="progress-bar"></div>
+    </div>
+    <button id="increment-button">Increment Progress</button>
+    <script src="progress-bar-demo.js"></script>
+</body>
+</html>--- a/progress-bar-demo.js
+++ b/progress-bar-demo.js
@@ -0,0 +1,12 @@
+document.addEventListener('DOMContentLoaded', function() {
+    const progressBar = document.getElementById('progress-bar');
+    const incrementButton = document.getElementById('increment-button');
+    let progressValue = 0;
+
+    incrementButton.addEventListener('click', function() {
+        if (progressValue < 100) {
+            progressValue += 10;
+            progressBar.style.width = progressValue + '%';
+        }
+    });
+});