--- a/index.html
+++ b/index.html
@@ -0,0 +1,29 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Tabs Component Demo</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div class="tabs-container">
+        <button class="tab-button active" onclick="openTab(event, 'Panel1')">Panel 1</button>
+        <button class="tab-button" onclick="openTab(event, 'Panel2')">Panel 2</button>
+        <button class="tab-button" onclick="openTab(event, 'Panel3')">Panel 3</button>
+    </div>
+    <div id="Panel1" class="tab-content active">
+        <h2>Content of Panel 1</h2>
+        <p>This is the content for panel 1.</p>
+    </div>
+    <div id="Panel2" class="tab-content">
+        <h2>Content of Panel 2</h2>
+        <p>This is the content for panel 2.</p>
+    </div>
+    <div id="Panel3" class="tab-content">
+        <h2>Content of Panel 3</h2>
+        <p>This is the content for panel 3.</p>
+    </div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,13 @@
+function openTab(evt, tabName) {
+    var i, tabcontent, tablinks;
+    tabcontent = document.getElementsByClassName('tab-content');
+    for (i = 0; i < tabcontent.length; i++) {
+        tabcontent[i].classList.remove('active');
+    }
+    tablinks = document.getElementsByClassName('tab-button');
+    for (i = 0; i < tablinks.length; i++) {
+        tablinks[i].className = tablinks[i].className.replace(' active', '');
+    }
+    document.getElementById(tabName).classList.add('active');
+    evt.currentTarget.className += ' active';
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,17 @@
+.tabs-container {
+    display: flex;
+}
+.tab-button {
+    padding: 10px 20px;
+    cursor: pointer;
+}
+.tab-button.active {
+    background-color: #f1f1f1;
+}
+.tab-content {
+    display: none;
+    padding: 20px;
+}
+.tab-content.active {
+    display: block;
+}