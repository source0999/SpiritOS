--- a/index.html
+++ b/index.html
@@ -0,0 +1,20 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Image Gallery</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div class="gallery">
+        <img src="image1.jpg" alt="Image 1" onclick="selectImage(this)">
+        <img src="image2.jpg" alt="Image 2" onclick="selectImage(this)">
+        <img src="image3.jpg" alt="Image 3" onclick="selectImage(this)">
+    </div>
+    <div class="selected-image">
+        <img id="selected" src="image1.jpg" alt="Selected Image">
+    </div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,3 @@
+function selectImage(img) {
+    document.getElementById('selected').src = img.src;
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,10 @@
+.gallery img {
+    width: 100px;
+    margin: 5px;
+    cursor: pointer;
+}
+
+.selected-image img {
+    max-width: 80%;
+    margin-top: 20px;
+}