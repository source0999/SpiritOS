--- a/index.html
+++ b/index.html
@@ -0,0 +1,16 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Budget Splitter</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Budget Splitter</h1>
+    <input type="number" id="total-budget" placeholder="Total Budget">
+    <button onclick="splitBudget()">Split Budget</button>
+    <div id="result"></div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,10 @@
+function splitBudget() {
+    const total = parseFloat(document.getElementById('total-budget').value);
+    if (isNaN(total)) {
+        document.getElementById('result').innerText = 'Please enter a valid number.';
+        return;
+    }
+    const share1 = total * 0.5;
+    const share2 = total - share1;
+    document.getElementById('result').innerText = `Share 1: ${share1.toFixed(2)}, Share 2: ${share2.toFixed(2)}`;
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,7 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#result {
+    margin-top: 20px;
+    font-size: 1.5em;
+}