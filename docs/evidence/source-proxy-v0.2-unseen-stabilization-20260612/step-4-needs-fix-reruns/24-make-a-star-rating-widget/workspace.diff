--- a/star-rating-widget.css
+++ b/star-rating-widget.css
@@ -0,0 +1,8 @@
+.star {
+    cursor: pointer;
+    color: #ccc;
+}
+
+.star.selected {
+    color: #ffcc00;
+}--- a/star-rating-widget.html
+++ b/star-rating-widget.html
@@ -0,0 +1,19 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Star Rating Widget</title>
+    <link rel="stylesheet" href="star-rating-widget.css">
+</head>
+<body>
+    <div id="rating-container">
+        <span class="star" onclick="selectRating(1)">★</span>
+        <span class="star" onclick="selectRating(2)">★</span>
+        <span class="star" onclick="selectRating(3)">★</span>
+        <span class="star" onclick="selectRating(4)">★</span>
+        <span class="star" onclick="selectRating(5)">★</span>
+    </div>
+    <script src="star-rating-widget.js"></script>
+</body>
+</html>--- a/star-rating-widget.js
+++ b/star-rating-widget.js
@@ -0,0 +1,13 @@
+function selectRating(rating) {
+    const stars = document.querySelectorAll('.star');
+    stars.forEach((star, index) => {
+        if (index < rating - 1) {
+            star.classList.add('selected');
+        } else {
+            star.classList.remove('selected');
+        }
+    });
+}
+
+// Initial state
+selectRating(0);