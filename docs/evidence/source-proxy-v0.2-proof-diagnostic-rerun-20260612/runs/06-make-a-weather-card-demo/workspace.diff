--- a/weather-card.css
+++ b/weather-card.css
@@ -0,0 +1,8 @@
+.weather-card {
+    border: 1px solid #ccc;
+    padding: 20px;
+    text-align: center;
+}
+button {
+    margin-top: 10px;
+}--- a/weather-card.html
+++ b/weather-card.html
@@ -0,0 +1,18 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Weather Card</title>
+    <link rel="stylesheet" href="weather-card.css">
+</head>
+<body>
+    <div class="weather-card">
+        <h2 id="city">City</h2>
+        <p id="temperature">Temperature</p>
+        <p id="condition">Condition</p>
+        <button onclick="changeWeather()">Change Weather</button>
+    </div>
+    <script src="weather-card.js"></script>
+</body>
+</html>--- a/weather-card.js
+++ b/weather-card.js
@@ -0,0 +1,9 @@
+function changeWeather() {
+    const city = document.getElementById('city');
+    const temperature = document.getElementById('temperature');
+    const condition = document.getElementById('condition');
+
+    city.textContent = 'New City';
+    temperature.textContent = '25°C';
+    condition.textContent = 'Sunny';
+}