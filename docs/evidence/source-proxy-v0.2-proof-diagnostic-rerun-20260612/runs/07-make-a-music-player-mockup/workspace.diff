--- a/music-player.css
+++ b/music-player.css
@@ -0,0 +1,21 @@
+.player-container {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    width: 300px;
+    margin: 50px auto;
+}
+
+#track-art {
+    width: 100%;
+    max-width: 200px;
+}
+
+#play-pause-btn {
+    margin-top: 20px;
+}
+
+#progress-bar {
+    margin-top: 10px;
+}--- a/music-player.html
+++ b/music-player.html
@@ -0,0 +1,19 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Music Player</title>
+    <link rel="stylesheet" href="music-player.css">
+</head>
+<body>
+    <div class="player-container">
+        <img id="track-art" src="track-art.jpg" alt="Track Art">
+        <h2 id="track-title">Track Title</h2>
+        <p id="artist-name">Artist Name</p>
+        <button id="play-pause-btn">Play</button>
+        <input type="range" id="progress-bar" min="0" max="100" value="0">
+    </div>
+    <script src="music-player.js"></script>
+</body>
+</html>--- a/music-player.js
+++ b/music-player.js
@@ -0,0 +1,8 @@
+document.getElementById('play-pause-btn').addEventListener('click', function() {
+    var btn = this;
+    if (btn.textContent === 'Play') {
+        btn.textContent = 'Pause';
+    } else {
+        btn.textContent = 'Play';
+    }
+});