--- a/habit-tracker.css
+++ b/habit-tracker.css
@@ -0,0 +1,9 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#habits {
+    margin-top: 20px;
+}
+h1 {
+    text-align: center;
+}--- a/habit-tracker.html
+++ b/habit-tracker.html
@@ -0,0 +1,14 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Habit Tracker</title>
+    <link rel="stylesheet" href="habit-tracker.css">
+</head>
+<body>
+    <h1>Habit Tracker</h1>
+    <div id="habits"></div>
+    <script src="habit-tracker.js"></script>
+</body>
+</html>--- a/habit-tracker.js
+++ b/habit-tracker.js
@@ -0,0 +1,16 @@
+document.addEventListener('DOMContentLoaded', function() {
+    const habitsContainer = document.getElementById('habits');
+
+    // Example habit data
+    const habits = [
+        { name: 'Drink water', completed: false },
+        { name: 'Read a book', completed: true }
+    ];
+
+    habits.forEach(habit => {
+        const habitElement = document.createElement('div');
+        habitElement.className = 'habit';
+        habitElement.innerHTML = `<span>${habit.name}</span><input type="checkbox" ${habit.completed ? 'checked' : ''}>`;
+        habitsContainer.appendChild(habitElement);
+    });
+});