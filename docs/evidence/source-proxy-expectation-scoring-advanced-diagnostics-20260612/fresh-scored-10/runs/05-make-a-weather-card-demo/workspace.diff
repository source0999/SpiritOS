--- a/weather-card.css
+++ b/weather-card.css
@@ -0,0 +1,11 @@
+.weather-card {
+    border: 1px solid #ccc;
+    padding: 20px;
+    width: 300px;
+    margin: 0 auto;
+}
+
+input, button {
+    display: block;
+    margin-top: 10px;
+}--- a/weather-card.html
+++ b/weather-card.html
@@ -0,0 +1,19 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Weather Card</title>
+    <link rel="stylesheet" href="weather-card.css">
+</head>
+<body>
+    <div class="weather-card">
+        <h2 id="city">City</h2>
+        <p id="temperature">Temperature: 0°C</p>
+        <p id="condition">Condition: Clear</p>
+        <input type="text" id="city-input" placeholder="Enter city">
+        <button onclick="updateWeather()">Update Weather</button>
+    </div>
+    <script src="weather-card.js"></script>
+</body>
+</html>--- a/weather-card.js
+++ b/weather-card.js
@@ -0,0 +1,21 @@
+function updateWeather() {
+    const cityInput = document.getElementById('city-input').value;
+    const cityElement = document.getElementById('city');
+    const temperatureElement = document.getElementById('temperature');
+    const conditionElement = document.getElementById('condition');
+
+    // Simulate weather data for demonstration purposes
+    const weatherData = {
+        'New York': { temperature: 15, condition: 'Cloudy' },
+        'London': { temperature: 10, condition: 'Rainy' },
+        'Tokyo': { temperature: 25, condition: 'Sunny' }
+    };
+
+    if (weatherData[cityInput]) {
+        cityElement.textContent = cityInput;
+        temperatureElement.textContent = `Temperature: ${weatherData[cityInput].temperature}°C`;
+        conditionElement.textContent = `Condition: ${weatherData[cityInput].condition}`;
+    } else {
+        alert('City not found.');
+    }
+}
