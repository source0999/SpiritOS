+</head>
+<body>
+    <div class="timer-container">
+        <h1 id="timer">00:00</h1>
+        <button id="startBtn">Start</button>
+        <button id="stopBtn">Stop</button>
+    </div>
+    <script src="script.js"></script>
+</body>
