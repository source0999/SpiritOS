--- a/water_drinking_tracker.css
+++ b/water_drinking_tracker.css
@@ -0,0 +1,15 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#tracker {
+    text-align: center;
+    margin-top: 50px;
+}
+button {
+    padding: 10px 20px;
+    font-size: 16px;
+}
+p {
+    margin-top: 20px;
