+}--- a/water_drinking_tracker.html
+++ b/water_drinking_tracker.html
@@ -0,0 +1,17 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Water Drinking Tracker</title>
+    <link rel="stylesheet" href="water_drinking_tracker.css">
+</head>
+<body>
+    <h1>Water Drinking Tracker</h1>
+    <div id="tracker">
+        <button onclick="drinkWater()">Drink Water</button>
+        <p id="count">0 glasses of water</p>
+    </div>
+    <script src="water_drinking_tracker.js"></script>
+</body>
+</html>--- a/water_drinking_tracker.js
+++ b/water_drinking_tracker.js
@@ -0,0 +1,6 @@
+let count = 0;
+
+function drinkWater() {
+    count++;
+    document.getElementById('count').textContent = count + ' glasses of water';
+}