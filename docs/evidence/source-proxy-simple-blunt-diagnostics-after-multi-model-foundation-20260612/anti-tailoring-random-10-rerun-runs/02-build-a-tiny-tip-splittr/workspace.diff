--- a/index.html
+++ b/index.html
@@ -0,0 +1,19 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Tiny Tip Splittr</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div class="container">
+        <h1>Tiny Tip Splittr</h1>
+        <input type="number" id="total" placeholder="Total Amount">
+        <input type="number" id="tipPercentage" placeholder="Tip Percentage">
+        <button onclick="calculateTip()">Calculate Tip</button>
+        <p>Tip: <span id="tipResult"></span></p>
+    </div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,10 @@
+function calculateTip() {
+    const total = parseFloat(document.getElementById('total').value);
+    const tipPercentage = parseFloat(document.getElementById('tipPercentage').value);
+    if (!isNaN(total) && !isNaN(tipPercentage)) {
+        const tip = (total * tipPercentage) / 100;
+        document.getElementById('tipResult').innerText = `$${tip.toFixed(2)}`;
+    } else {
+        document.getElementById('tipResult').innerText = 'Invalid input';
+    }
+}--- a/styles.css
