--- a/index.html
+++ b/index.html
@@ -0,0 +1,17 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Quick Bill Sharer</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Quick Bill Sharer</h1>
+    <input type="number" id="totalBill" placeholder="Total Bill Amount">
+    <input type="number" id="numberOfPeople" placeholder="Number of People">
+    <button onclick="calculateShare()">Calculate Share</button>
+    <p id="result"></p>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,10 @@
+function calculateShare() {
+    const totalBill = parseFloat(document.getElementById('totalBill').value);
+    const numberOfPeople = parseInt(document.getElementById('numberOfPeople').value);
+    if (isNaN(totalBill) || isNaN(numberOfPeople) || numberOfPeople <= 0) {
+        document.getElementById('result').innerText = 'Invalid input';
+    } else {
+        const share = totalBill / numberOfPeople;
+        document.getElementById('result').innerText = `Each person should pay: $${share.toFixed(2)}`;
+    }
+}--- a/styles.css
