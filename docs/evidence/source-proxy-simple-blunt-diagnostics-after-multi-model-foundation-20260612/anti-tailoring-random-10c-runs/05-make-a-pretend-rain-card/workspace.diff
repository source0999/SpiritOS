--- a/rain_card.css
+++ b/rain_card.css
@@ -0,0 +1,19 @@
+body {
+    font-family: Arial, sans-serif;
+    background-color: #f0f0f0;
+}
+
+.rain-card {
+    width: 300px;
+    padding: 20px;
+    margin: 50px auto;
+    background-color: #fff;
+    border-radius: 8px;
+    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
+}
+h1 {
+    color: #333;
+}
+p {
+    color: #666;
+}--- a/rain_card.html
+++ b/rain_card.html
@@ -0,0 +1,15 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Rain Card</title>
+    <link rel="stylesheet" href="rain_card.css">
+</head>
+<body>
+    <div class="rain-card">
+        <h1>It's Raining!</h1>
+        <p>Stay dry and enjoy the rain.</p>
+    </div>
+</body>
+</html>