--- a/index.html
+++ b/index.html
@@ -0,0 +1,18 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Scratch Notes App</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div class="container">
+        <h1>Scratch Notes App</h1>
+        <textarea id="notes" placeholder="Enter your notes here..."></textarea>
+        <button id="saveButton">Save Note</button>
+        <p id="status"></p>
+    </div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,17 @@
+document.getElementById('saveButton').addEventListener('click', function() {
+    const notes = document.getElementById('notes').value;
+    if (notes.trim() === '') {
+        document.getElementById('status').innerText = 'Please enter some notes.';
+        return;
+    }
+    localStorage.setItem('scratchNotes', notes);
+    document.getElementById('status').innerText = 'Note saved!';
+});
+
+window.onload = function() {
+    const savedNotes = localStorage.getItem('scratchNotes');
+    if (savedNotes) {
+        document.getElementById('notes').value = savedNotes;
+        document.getElementById('status').innerText = 'Note loaded from local storage.';
+    }
+};--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,32 @@
