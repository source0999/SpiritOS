--- a/index.html
+++ b/index.html
@@ -0,0 +1,14 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Doodle Canvas Notebook</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Doodle Canvas Notebook</h1>
+    <canvas id="drawingSurface" width="800" height="600"></canvas>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,25 @@
+const drawingSurface = document.getElementById('drawingSurface');
+let isDrawing = false;
+
+function startDrawing(e) {
+    isDrawing = true;
+    draw(e);
+}
+
+function stopDrawing() {
+    isDrawing = false;
+}
+
+function draw(e) {
+    if (!isDrawing) return;
+    const ctx = drawingSurface.getContext('2d');
+    ctx.lineWidth = 5;
+    ctx.lineCap = 'round';
+    ctx.strokeStyle = '#000';
+    ctx.lineTo(e.clientX - drawingSurface.offsetLeft, e.clientY - drawingSurface.offsetTop);
+    ctx.stroke();
+}
+
+drawingSurface.addEventListener('mousedown', startDrawing);
+drawingSurface.addEventListener('mouseup', stopDrawing);
+drawingSurface.addEventListener('mousemove', draw);--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,6 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#drawingSurface {
+    border: 1px solid #000;
+}