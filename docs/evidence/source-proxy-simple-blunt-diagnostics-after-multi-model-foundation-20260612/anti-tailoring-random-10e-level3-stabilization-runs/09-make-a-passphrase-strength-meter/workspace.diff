--- a/passphrase_strength_meter.css
+++ b/passphrase_strength_meter.css
@@ -0,0 +1,11 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#strengthFeedback {
+    margin-top: 20px;
+    padding: 10px;
+    border-radius: 5px;
+}
+.weak { background-color: #ffcccc; }
+.medium { background-color: #ffff99; }
+.strong { background-color: #ccffcc; }--- a/passphrase_strength_meter.html
+++ b/passphrase_strength_meter.html
@@ -0,0 +1,15 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Passphrase Strength Meter</title>
+    <link rel="stylesheet" href="passphrase_strength_meter.css">
+</head>
+<body>
+    <h1>Passphrase Strength Meter</h1>
+    <input type="password" id="passphraseInput" placeholder="Enter your passphrase">
+    <div id="strengthFeedback"></div>
+    <script src="passphrase_strength_meter.js"></script>
+</body>
+</html>--- a/passphrase_strength_meter.js
+++ b/passphrase_strength_meter.js
@@ -0,0 +1,14 @@
+document.getElementById('passphraseInput').addEventListener('input', function() {
+    const passphrase = this.value;
+    const strengthFeedback = document.getElementById('strengthFeedback');
+    if (passphrase.length < 8) {
+        strengthFeedback.textContent = 'Weak';
+        strengthFeedback.className = 'weak';
+    } else if (passphrase.length >= 8 && passphrase.length < 12) {
+        strengthFeedback.textContent = 'Medium';
+        strengthFeedback.className = 'medium';
+    } else {
+        strengthFeedback.textContent = 'Strong';
+        strengthFeedback.className = 'strong';
+    }
+});