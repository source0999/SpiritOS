--- a/index.html
+++ b/index.html
@@ -0,0 +1,16 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Camping Packing List</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Camping Packing List</h1>
+    <input type="text" id="itemInput" placeholder="Add an item">
+    <button onclick="addItem()">Add Item</button>
+    <ul id="packingList"></ul>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,11 @@
+function addItem() {
+    const input = document.getElementById('itemInput');
+    const itemText = input.value.trim();
+    if (itemText !== '') {
+        const list = document.getElementById('packingList');
+        const li = document.createElement('li');
+        li.textContent = itemText;
+        list.appendChild(li);
+        input.value = '';
+    }
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,3 @@
+body { font-family: Arial, sans-serif; }
+#packingList { margin-top: 20px; }
+li { margin-bottom: 5px; }