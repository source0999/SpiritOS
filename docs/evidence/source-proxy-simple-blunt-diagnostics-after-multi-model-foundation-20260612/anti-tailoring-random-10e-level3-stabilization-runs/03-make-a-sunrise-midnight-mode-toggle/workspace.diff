--- a/index.html
+++ b/index.html
@@ -0,0 +1,14 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Sunrise Midnight Mode Toggle</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body class="light-theme">
+    <h1>Sunrise Midnight Mode Toggle</h1>
+    <button id="toggleButton">Toggle Midnight Mode</button>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,3 @@
+document.getElementById('toggleButton').addEventListener('click', function() {
+    document.body.classList.toggle('midnight-mode');
+});--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,2 @@
+.light-theme { background-color: #fff; color: #000; }
+.midnight-mode { background-color: #121212; color: #fff; }