--- a/index.html
+++ b/index.html
@@ -0,0 +1,13 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Scribble Sketch Pad</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <canvas id="drawingSurface" width="800" height="600"></canvas>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,27 @@
+const drawingSurface = document.getElementById('drawingSurface');
+let isDrawing = false;
+
+function startDrawing(e) {
+    isDrawing = true;
+    draw(e);
+}
+
+function stopDrawing() {
+    isDrawing = false;
+    drawingSurface.style.cursor = 'default';
+}
+
+function draw(e) {
+    if (!isDrawing) return;
+    const ctx = drawingSurface.getContext('2d');
+    ctx.lineWidth = 5;
+    ctx.lineCap = 'round';
+    ctx.strokeStyle = 'black';
+    ctx.lineTo(e.clientX - drawingSurface.offsetLeft, e.clientY - drawingSurface.offsetTop);
+    ctx.stroke();
+}
+
+drawingSurface.addEventListener('mousedown', startDrawing);
+drawingSurface.addEventListener('mouseup', stopDrawing);
+drawingSurface.addEventListener('mousemove', draw);
+drawingSurface.addEventListener('mouseleave', stopDrawing);--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,2 @@
+body { margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f0f0f0; }
+#drawingSurface { border: 2px solid black; }