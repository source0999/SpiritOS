--- a/login_safety_gauge.css
+++ b/login_safety_gauge.css
@@ -0,0 +1,42 @@
+body {
+    font-family: Arial, sans-serif;
+    background-color: #f4f4f9;
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    height: 100vh;
+}
+
+.safety-gauge {
+    text-align: center;
+    background-color: white;
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
+}
+
+input[type="password"] {
+    width: calc(100% - 22px);
+    padding: 10px;
+    margin-bottom: 10px;
+    border: 1px solid #ccc;
+    border-radius: 4px;
+}
+
+button {
+    padding: 10px 20px;
+    background-color: #007bff;
+    color: white;
+    border: none;
+    border-radius: 4px;
+    cursor: pointer;
+}
+
+button:hover {
+    background-color: #0056b3;
+}
+
+#result {
+    margin-top: 20px;
+    font-size: 18px;
+}--- a/login_safety_gauge.html
+++ b/login_safety_gauge.html
@@ -0,0 +1,18 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Login Safety Gauge</title>
+    <link rel="stylesheet" href="login_safety_gauge.css">
+</head>
+<body>
+    <div class="safety-gauge">
+        <h1>Login Safety Gauge</h1>
+        <input type="password" id="password-input" placeholder="Enter your password">
+        <button onclick="checkSafety()">Check Safety</button>
+        <p id="result"></p>
+    </div>
+    <script src="login_safety_gauge.js"></script>
+</body>
+</html>--- a/login_safety_gauge.js
+++ b/login_safety_gauge.js
@@ -0,0 +1,18 @@
+function checkSafety() {
+    const password = document.getElementById('password-input').value;
+    let result = 'Password is safe.';
+
+    if (password.length < 8) {
+        result = 'Password should be at least 8 characters long.';
+    } else if (!/[a-z]/.test(password)) {
+        result = 'Password should contain at least one lowercase letter.';
+    } else if (!/[A-Z]/.test(password)) {
+        result = 'Password should contain at least one uppercase letter.';
+    } else if (!/\d/.test(password)) {
+        result = 'Password should contain at least one number.';
+    } else if (!/[!@#$%^&*(),.?":{}|<>]/.test(password)) {
+        result = 'Password should contain at least one special character.';
+    }
+
+    document.getElementById('result').innerText = result;
+}