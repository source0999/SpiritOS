--- a/index.html
+++ b/index.html
@@ -0,0 +1,13 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Scribble Sketch Pad</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <canvas id="drawingSurface" width="800" height="600"></canvas>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,20 @@
+const drawingSurface = document.getElementById('drawingSurface');
+drawingSurface.addEventListener('pointerdown', startDrawing);
+drawingSurface.addEventListener('pointermove', draw);
+drawingSurface.addEventListener('pointerup', stopDrawing);
+let isDrawing = false;
+function startDrawing(event) {
+    isDrawing = true;
+}
+function draw(event) {
+    if (isDrawing) {
+        const ctx = drawingSurface.getContext('2d');
+        ctx.beginPath();
+        ctx.moveTo(event.offsetX, event.offsetY);
+        ctx.lineTo(event.offsetX, event.offsetY);
+        ctx.stroke();
+    }
+}
+function stopDrawing() {
+    isDrawing = false;
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,10 @@
+body {
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    height: 100vh;
+    margin: 0;
+}
+#drawingSurface {
+    border: 2px solid black;
+}