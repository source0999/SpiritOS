--- a/index.html
+++ b/index.html
@@ -0,0 +1,16 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Pizza Money Splitter</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Pizza Money Splitter</h1>
+    <input type="number" id="totalAmount" placeholder="Total Pizza Cost">
+    <button onclick="splitMoney()">Split Money</button>
+    <p>Total per person: <span id="result"></span></p>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,9 @@
+function splitMoney() {
+    const totalAmount = parseFloat(document.getElementById('totalAmount').value);
+    if (!isNaN(totalAmount)) {
+        const resultElement = document.getElementById('result');
+        resultElement.textContent = (totalAmount / 2).toFixed(2);
+    } else {
+        alert('Please enter a valid number.');
+    }
+}--- a/styles.css
