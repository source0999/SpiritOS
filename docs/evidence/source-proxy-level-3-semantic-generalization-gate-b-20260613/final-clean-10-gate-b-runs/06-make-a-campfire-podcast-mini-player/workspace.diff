--- a/index.html
+++ b/index.html
@@ -0,0 +1,17 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Campfire Podcast Mini Player</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div class="player-container">
+        <h2 id="track-title">Track Title</h2>
+        <button id="play-pause-btn">Play</button>
+        <button id="skip-btn">Skip</button>
+    </div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,15 @@
+document.getElementById('play-pause-btn').addEventListener('click', function() {
+    var btn = this;
+    if (btn.textContent === 'Play') {
+        btn.textContent = 'Pause';
+        // Simulate playing track
+    } else {
+        btn.textContent = 'Play';
+        // Simulate pausing track
+    }
+});
+
+document.getElementById('skip-btn').addEventListener('click', function() {
+    // Simulate skipping to next track
+    document.getElementById('track-title').textContent = 'Next Track Title';
+});--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,15 @@
+.player-container {
+    text-align: center;
+    margin-top: 50px;
+}
+
+#track-title {
+    font-size: 24px;
+    margin-bottom: 10px;
+}
+
+button {
+    padding: 10px 20px;
+    margin: 5px;
+    cursor: pointer;
+}