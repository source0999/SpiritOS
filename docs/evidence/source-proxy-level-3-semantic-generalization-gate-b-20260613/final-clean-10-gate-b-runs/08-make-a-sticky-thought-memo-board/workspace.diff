--- a/index.html
+++ b/index.html
@@ -0,0 +1,15 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Sticky Thought Memo Board</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div id="memo-board"></div>
+    <input type="text" id="new-memo" placeholder="Add a new memo...">
+    <button onclick="addMemo()">Add Memo</button>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,12 @@
+function addMemo() {
+    const memoText = document.getElementById('new-memo').value;
+    if (memoText.trim() === '') return;
+
+    const memoItem = document.createElement('div');
+    memoItem.className = 'memo-item';
+    memoItem.textContent = memoText;
+
+    document.getElementById('memo-board').appendChild(memoItem);
+
+    document.getElementById('new-memo').value = '';
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,21 @@
+body {
+    font-family: Arial, sans-serif;
+}
+#memo-board {
+    margin-top: 20px;
+}
+.memo-item {
+    background-color: #f4f4f4;
+    padding: 10px;
+    margin-bottom: 5px;
+    border-radius: 5px;
+}
+input[type="text"] {
+    width: calc(100% - 22px);
+    padding: 10px;
+    margin-top: 10px;
+}
+button {
+    padding: 10px 20px;
+    margin-top: 10px;
+}