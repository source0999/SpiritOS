--- a/index.html
+++ b/index.html
@@ -0,0 +1,18 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Balcony Forecast Tile</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <div class="weather-card">
+        <h2>City: San Francisco</h2>
+        <p id="temperature">Temperature: 68°F</p>
+        <p id="condition">Condition: Sunny</p>
+        <button onclick="changeWeather('New York', '70°F', 'Cloudy')">Change Weather to New York</button>
+    </div>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,5 @@
+function changeWeather(city, temperature, condition) {
+    document.getElementById('city').innerText = 'City: ' + city;
+    document.getElementById('temperature').innerText = 'Temperature: ' + temperature;
+    document.getElementById('condition').innerText = 'Condition: ' + condition;
+}--- a/styles.css
+++ b/styles.css
@@ -0,0 +1,8 @@
+.weather-card {
+    border: 1px solid #ccc;
+    padding: 20px;
+    text-align: center;
+}
+button {
+    margin-top: 10px;
+}