{
  "matrix_version": "phase-7.3-v0.1",
  "default_authority": {
    "read_only_inspection": true,
    "preview_generation": true,
    "file_write": false,
    "command_execution": false,
    "workflow_execution": false,
    "queue_execution": false,
    "worker_start": false,
    "provider_call": false,
    "obsidian_write": false,
    "git_mutation": false
  },
  "preview_allowed_surfaces": [
    {
      "surface": "source_proxy/api/action_preview.py",
      "allowed_use": "Classify action and approval requirement.",
      "execution_allowed": false
    },
    {
      "surface": "source_proxy/cartographer/workflow_state.py",
      "allowed_use": "Model workflow state transitions.",
      "execution_allowed": false
    },
    {
      "surface": "source_proxy/cartographer/workflow_controls.py",
      "allowed_use": "Model pause, resume, cancel, timeout, and retry controls.",
      "execution_allowed": false
    },
    {
      "surface": "source_proxy/cartographer/workflow_event_ledger.py",
      "allowed_use": "Preview event shapes and append-only validation.",
      "execution_allowed": false
    },
    {
      "surface": "source_proxy/cartographer/safe_write.py",
      "allowed_use": "Use `preview_safe_write_request` semantics only.",
      "execution_allowed": false
    },
    {
      "surface": "source_proxy/cartographer/verification_runner.py",
      "allowed_use": "Use argv preview and allowlist semantics only.",
      "execution_allowed": false
    }
  ],
  "execution_substrates_deferred": [
    {
      "surface": "POST /v1/tasks/long-running/{task_id}/execute-approved",
      "phase_7_status": "forbidden",
      "reason": "Would apply approved diffs or execute protected workflow."
    },
    {
      "surface": "POST /v1/sandbox/terminal/run",
      "phase_7_status": "forbidden",
      "reason": "Would run a sandboxed command."
    },
    {
      "surface": "source_proxy/cartographer/safe_write.py::execute_safe_write_request",
      "phase_7_status": "forbidden",
      "reason": "Would write a file."
    },
    {
      "surface": "source_proxy/cartographer/workflow_runner.py::execute_safe_docs_evidence_workflow",
      "phase_7_status": "forbidden",
      "reason": "Would compose safe write, verification command, and event append preview into workflow execution."
    },
    {
      "surface": "POST /v1/chat/completions",
      "phase_7_status": "forbidden",
      "reason": "Would call local or provider model route."
    }
  ],
  "path_policy": {
    "phase_7_write_allowed_paths": [],
    "preview_only_future_possible_paths": [
      "docs/evidence/spiritos-cognitive-control-plane-revamp-v0.1/**"
    ],
    "protected_paths": [
      ".env",
      "secrets",
      "source_proxy/**",
      "src/app/**",
      "src/components/**",
      "src/lib/**",
      "generated diagnostic artifacts",
      ".git/**"
    ]
  },
  "hard_stop_actions": [
    "provider/model calls",
    "automatic worker starts",
    "Obsidian writes",
    "git add",
    "git commit",
    "git push",
    "git branch",
    "git checkout",
    "git reset",
    "git stash",
    "git clean",
    "generated benchmark artifact mutation",
    "production UI rewrites",
    "Source Proxy behavior changes"
  ]
}
