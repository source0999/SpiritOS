{
  "schema_name": "integrated_dry_run_gate_receipt",
  "schema_version": "phase-8.3-v0.1",
  "required_fields": [
    "dry_run_id",
    "created_at",
    "request_summary",
    "phase_gates",
    "final_verdict",
    "reason_codes",
    "unverified_checks",
    "blocked_actions",
    "non_authority_flags",
    "product_truth",
    "phase_9_readiness",
    "next_safe_action"
  ],
  "phase_gates": {
    "phase_1_truth": "PASS | FAIL | NEEDS_FIX | UNVERIFIED | BLOCKED | PARTIAL",
    "phase_2_memory": "ready | blocked | unverified",
    "phase_3_context": "preview_ready | needs_clarification | blocked_preview | unverified_context",
    "phase_4_risk_permission": "preview_only | requires_human_approval | blocked | needs_clarification | unverified_gate",
    "phase_5_worker_selector": "recommendation_ready | selection_blocked | needs_clarification | no_suitable_worker | unverified_capability",
    "phase_6_behavior_verifier": "PASS | FAIL | NEEDS_FIX | UNVERIFIED | BLOCKED | PARTIAL",
    "phase_7_safe_execution": "preview_ready | requires_human_approval | blocked | unverified"
  },
  "final_verdict_rules": [
    {
      "if_any_gate": ["blocked", "blocked_preview", "selection_blocked", "BLOCKED"],
      "final_verdict": "BLOCKED"
    },
    {
      "if_phase_6_behavior_verifier": ["FAIL"],
      "final_verdict": "BLOCKED",
      "reason": "product behavior truth blocks later execution proof"
    },
    {
      "if_any_gate": ["UNVERIFIED", "unverified_context", "unverified_gate", "unverified_capability", "unverified"],
      "final_verdict": "UNVERIFIED"
    },
    {
      "if_required_system_gap": true,
      "final_verdict": "NEEDS_FIX"
    },
    {
      "if_some_gates_ready_and_some_not_ready": true,
      "final_verdict": "PARTIAL"
    },
    {
      "if_all_preview_gates_shaped_and_no_hard_blockers": true,
      "final_verdict": "DRY_RUN_READY"
    }
  ],
  "non_authority_flags": {
    "would_execute": false,
    "would_write": false,
    "would_call_provider": false,
    "would_start_worker": false,
    "would_dispatch_worker": false,
    "would_write_obsidian": false,
    "would_mutate_git": false,
    "would_mutate_generated_artifacts": false,
    "product_pass_claimed_without_phase_6_proof": false
  },
  "phase_9_readiness": {
    "allowed_values": ["not_ready", "ready_for_controlled_live_proof_review"],
    "requires": [
      "final_verdict is DRY_RUN_READY",
      "Phase 6 behavior verifier does not block",
      "Phase 7 safe execution preview does not execute",
      "all unverified checks are named",
      "operator approval required before live proof"
    ]
  }
}
