{
  "contract_version": "phase-8.2-v0.1",
  "mode": "integrated_dry_run_preview_only",
  "core_loop": [
    "sense",
    "understand",
    "remember",
    "prioritize",
    "plan",
    "choose_worker",
    "act",
    "verify",
    "learn"
  ],
  "step_mapping": {
    "sense": {
      "input": "phase-3/context-router-preview-schema.json",
      "output": "request summary, target kind, selected read-only context"
    },
    "understand": {
      "input": "phase-1/canonical-truth-contract.json and phase-3 classification",
      "output": "acceptance criteria and truth references"
    },
    "remember": {
      "input": "phase-2/read-only-memory-contract.json",
      "output": "evidence and memory refs without write-back"
    },
    "prioritize": {
      "input": "phase-4/executive-preview-schema.json",
      "output": "risk classes, blocked actions, approval needs"
    },
    "plan": {
      "input": "phase-7/safe-execution-preview-contract.json",
      "output": "rollback and verification requirements"
    },
    "choose_worker": {
      "input": "phase-5/handoff-preview-schema.json",
      "output": "worker recommendation only, no dispatch"
    },
    "act": {
      "input": "phase-7/safe-execution-preview-contract.json",
      "output": "action plan preview only, no execution"
    },
    "verify": {
      "input": "phase-6/behavior-verifier-result-schema.json",
      "output": "truth label and proof tier"
    },
    "learn": {
      "input": "v0.2 deferred learning policy",
      "output": "learning event preview only, no write-back"
    }
  },
  "required_false_flags": {
    "would_execute": false,
    "would_write": false,
    "would_call_provider": false,
    "would_start_worker": false,
    "would_dispatch_worker": false,
    "would_write_obsidian": false,
    "would_mutate_git": false,
    "would_mutate_generated_artifacts": false,
    "safe_write_executed": false,
    "sandbox_command_run": false,
    "execute_approved_called": false,
    "learning_write_performed": false
  },
  "final_verdicts": [
    "DRY_RUN_READY",
    "BLOCKED",
    "UNVERIFIED",
    "NEEDS_FIX",
    "PARTIAL"
  ],
  "product_truth_boundary": {
    "dry_run_readiness_is_product_pass": false,
    "product_pass_source": "Phase 1 truth labels plus Phase 6 behavior proof"
  },
  "learning_boundary": {
    "automatic_learning_loop": "deferred_to_v0.2_or_stretch",
    "obsidian_write_back": "deferred_to_v0.2_or_stretch",
    "memory_updates": "deferred_to_v0.2_or_stretch"
  }
}
