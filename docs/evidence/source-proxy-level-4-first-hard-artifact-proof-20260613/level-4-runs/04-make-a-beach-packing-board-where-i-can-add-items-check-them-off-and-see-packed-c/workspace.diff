--- a/index.html
+++ b/index.html
@@ -0,0 +1,17 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Beach Packing Board</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Beach Packing Board</h1>
+    <ul id="packing-list"></ul>
+    <input type="text" id="item-input" placeholder="Add item...">
+    <button onclick="addItem()">Add Item</button>
+    <p>Packed Count: <span id="packed-count">0</span></p>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,23 @@
+let packedCount = 0;
+
+function addItem() {
+    const input = document.getElementById('item-input');
+    const itemText = input.value.trim();
+    if (itemText) {
+        const ul = document.getElementById('packing-list');
+        const li = document.createElement('li');
+        li.textContent = itemText;
+        li.onclick = function() {
+            this.style.textDecoration = 'line-through';
+            packedCount++;
+            updatePackedCount();
+        };
+        ul.appendChild(li);
+        input.value = '';
+    }
+}
+
+function updatePackedCount() {
+    const countElement = document.getElementById('packed-count');
+    countElement.textContent = packedCount;
+}--- a/styles.css
