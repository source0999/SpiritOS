--- a/index.html
+++ b/index.html
@@ -0,0 +1,24 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Parking Trip Cost Planner</title>
+    <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+    <h1>Parking Trip Cost Planner</h1>
+    <form id="cost-planner-form">
+        <label for="distance">Distance (km):</label>
+        <input type="number" id="distance" required><br><br>
+        <label for="fee">Parking Fee per km:</label>
+        <input type="number" id="fee" required><br><br>
+        <label for="tip">Tip Percentage (%):</label>
+        <input type="number" id="tip" required><br><br>
+        <button type="submit">Calculate Cost</button>
+    </form>
+    <div id="result"></div>
+    <button id="reset-button">Reset</button>
+    <script src="script.js"></script>
+</body>
+</html>--- a/script.js
+++ b/script.js
@@ -0,0 +1,19 @@
+document.getElementById('cost-planner-form').addEventListener('submit', function(event) {
+    event.preventDefault();
+    const distance = parseFloat(document.getElementById('distance').value);
+    const fee = parseFloat(document.getElementById('fee').value);
+    const tipPercentage = parseFloat(document.getElementById('tip').value);
+    if (isNaN(distance) || isNaN(fee) || isNaN(tipPercentage)) {
+        document.getElementById('result').innerText = 'Please enter valid numbers.';
+        return;
+    }
+    const totalFee = distance * fee;
+    const tipAmount = totalFee * (tipPercentage / 100);
+    const totalCost = totalFee + tipAmount;
+    document.getElementById('result').innerText = `Total Cost: $${totalCost.toFixed(2)}`;
+});
+
+document.getElementById('reset-button').addEventListener('click', function() {
+    document.getElementById('cost-planner-form').reset();
+    document.getElementById('result').innerText = '';
+});--- a/styles.css
