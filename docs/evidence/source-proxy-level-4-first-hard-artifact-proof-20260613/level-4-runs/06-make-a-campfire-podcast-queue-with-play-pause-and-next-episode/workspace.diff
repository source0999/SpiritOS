+++ b/script.js
@@ -0,0 +1,43 @@
+const episodes = [
+    { title: 'Episode 1', url: 'episode1.mp3' },
+    { title: 'Episode 2', url: 'episode2.mp3' },
+    { title: 'Episode 3', url: 'episode3.mp3' }
+];
+
+const episodeList = document.getElementById('episodeList');
+const playPauseBtn = document.getElementById('playPauseBtn');
+const nextEpisodeBtn = document.getElementById('nextEpisodeBtn');
+let currentEpisodeIndex = 0;
+let isPlaying = false;
+
+function renderEpisodes() {
+    episodes.forEach((episode, index) => {
+        const li = document.createElement('li');
+        li.textContent = episode.title;
+        if (index === currentEpisodeIndex) {
+            li.style.backgroundColor = '#e0e0e0';
+        }
+        episodeList.appendChild(li);
+    });
+}
+
+function playPause() {
+    if (isPlaying) {
+        // Pause logic here
+        playPauseBtn.textContent = 'Play';
+    } else {
+        // Play logic here
+        playPauseBtn.textContent = 'Pause';
+    }
+    isPlaying = !isPlaying;
+}
+
+function nextEpisode() {
+    currentEpisodeIndex = (currentEpisodeIndex + 1) % episodes.length;
+    renderEpisodes();
+}
+
+playPauseBtn.addEventListener('click', playPause);
+nextEpisodeBtn.addEventListener('click', nextEpisode);
+
+renderEpisodes();--- a/styles.css
