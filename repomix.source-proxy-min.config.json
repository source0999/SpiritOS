{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 500000
  },
  "output": {
    "filePath": "repomix-output.source-proxy-min.ast-inner.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "truncateBase64": true,
    "topFilesLength": 10,
    "headerText": "SpiritOS source-proxy-min profile — Source Proxy + coding lane context only. Do not upload repomix-output*.xml from repo root unless a reviewer asks for full context.",
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 50,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "README.md",
    "package.json",
    "repomix.config.json",
    "repomix.source-proxy-min.config.json",
    "repomix.repo-map.config.json",
    ".repomixignore",
    "scripts/repomix-llm.mjs",
    "scripts/source-context-compress.mjs",
    "scripts/postinstall-repomix-shim.mjs",
    "scripts/headroom-proxy-dev.sh",
    "scripts/context/**",
    "scripts/source-proxy-*.mjs",
    "scripts/source-proxy-*.sh",
    "scripts/restart-source-proxy-lan.sh",
    "scripts/mac-worker/**",
    "source_proxy/**",
    "src/app/coding/**",
    "src/components/coding/**",
    "src/lib/coding/**",
    "src/lib/mac-worker/**",
    "src/app/api/coding/**",
    "src/app/v1/coding/**",
    "src/app/v1/actions/**",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/master-plan.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/execution-handoff.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/canonical-state-and-event-contract.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/mvi-contract.json",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/build-vs-adapt-comparison.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/plan-*/status.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/plan-*/status.json",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/plan-*/plan.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/plan-*/plan-closeout.md",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/plan-*/plan-closeout.json",
    "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/plan-*/next-plan-handoff.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output*",
      "docs/evidence/**",
      "docs/handoff/**",
      "scripts/media/**",
      "fold7-media-grabber/**",
      "src/components/spiritflix/**",
      "src/app/spiritflix/**",
      "src/app/api/spiritflix/**",
      "src/lib/spiritflix/**",
      "src/styles/spiritflix.css",
      ".next",
      "dist",
      "node_modules",
      ".git",
      ".spirit-backups/**",
      "source_proxy/.spirit-backups/**",
      "source_proxy/data/**",
      "backend/searxng_data/**",
      "backend/volumes/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.sqlite",
      "**/*.db",
      "**/*.log",
      "package-lock.json",
      "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/**/artifacts/**",
      "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/**/codex-review/**",
      "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/**/acceptance-review*/**",
      "docs/source-proxy-human-brain-full-live-integration-pivot-20260619/**/continuation-*/**",
      "source_proxy/cartographer/soak-logs/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
