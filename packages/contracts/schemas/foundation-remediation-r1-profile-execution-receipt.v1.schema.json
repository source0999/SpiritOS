{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritos.local/schemas/foundation-remediation-r1-profile-execution-receipt.v1.schema.json",
  "title": "SpiritOS Foundation Remediation R1 profile execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "remediation_id",
    "profile_id",
    "command",
    "source_commit",
    "artifact_path",
    "artifact_sha256",
    "result",
    "passed",
    "claim_ceiling",
    "completed_at"
  ],
  "properties": {
    "schema": {
      "const": "spiritos-foundation-remediation-r1-profile-execution-receipt/v1"
    },
    "remediation_id": {
      "const": "spiritos-foundation-remediation-r1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "const": "pass"
    },
    "passed": {
      "const": true
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": ["GO", "go", "unbounded", "UNBOUNDED"]
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
