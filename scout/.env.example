# Phase 1: SQLite database location inside the Scout container.
SCOUT_DATABASE_PATH=/app/data/scout.db

# Phase 1: Scout-owned data root. Scout must only write under this directory.
SCOUT_DATA_DIR=/app/data

# Phase 1: FastAPI service port exposed by uvicorn.
SCOUT_API_PORT=8077

# Phase 2: Source allowlist file inside the Scout container.
SCOUT_CONFIG_PATH=/app/config/sources.yaml

# Phase 2: Optional GitHub token for higher rate limits when polling allowlisted repos.
# SCOUT_GITHUB_TOKEN=

# Phase 2: Polling pauses when the GitHub remaining rate limit falls below this value.
SCOUT_GITHUB_RATELIMIT_FLOOR=200

# Phase 2: External fetch timeout in seconds.
SCOUT_FETCH_TIMEOUT_SECONDS=15

# Phase 2: Maximum bytes Scout will read from a single external fetch.
SCOUT_FETCH_MAX_BYTES=2000000

# Phase 2: Temporary local debug endpoint for manually triggering a poll.
SCOUT_DEBUG_POLL_ENABLED=0

# Phase 4: Local LiteLLM model used for synthesis and packet analysis.
SCOUT_LITELLM_MODEL=ollama/llama3

# Phase 4: Timeout for each LiteLLM call in seconds.
SCOUT_LITELLM_TIMEOUT_SECONDS=30

# Phase 4: Require authenticated/local LLM routing before synthesis.
SCOUT_LITELLM_REQUIRE_AUTHED=1

# Phase 4: Number of extracted artifacts synthesized per scheduler run.
# Suggested local value: 3. Larger values can increase local Ollama load.
SCOUT_SYNTHESIS_BATCH_SIZE=3

# Phase 4: Maximum sqlite-vec packet embeddings Scout will store before failing closed.
SCOUT_VECTOR_PACKET_CAP=200000

# Phase 5: Debugger LLM model. When unset, this inherits SCOUT_LITELLM_MODEL.
# SCOUT_DEBUGGER_LLM_MODEL=

# Phase 5: Number of pending packets claimed by the debugger runner per batch.
SCOUT_DEBUGGER_BATCH_SIZE=25

# Phase 5: Debugger LLM model. When unset, Scout uses SCOUT_LITELLM_MODEL.
# SCOUT_DEBUGGER_LLM_MODEL=

# Phase 4F: Controlled Scout search provider. Disabled by default.
# To enable against the local backend SearXNG container, run backend local-search
# and start Scout with docker-compose.local.yml so host.docker.internal resolves.
SCOUT_SEARCH_ENABLED=false
SCOUT_SEARXNG_URL=
SCOUT_SEARCH_MAX_RESULTS=5
SCOUT_SEARCH_TIMEOUT_SECONDS=10
SCOUT_DISCOVERY_JOBS_ENABLED=true
SCOUT_DISCOVERY_JOBS_PER_DAY=3
SCOUT_DISCOVERY_CANDIDATES_PER_JOB=5

# Example local SearXNG URL when backend/local-search exposes host port 8080:
# SCOUT_SEARXNG_URL=http://host.docker.internal:8080

# Phase 6: Proxy-side flag that allows source_proxy to consult Scout.
SOURCE_PROXY_SCOUT_RESEARCH_ENABLED=0

# Phase 6: Proxy-side URL for the read-only Scout research bridge.
SOURCE_PROXY_SCOUT_RESEARCH_URL=http://localhost:8077

# Phase 6: Proxy-side timeout for Scout bridge calls in milliseconds.
SOURCE_PROXY_SCOUT_RESEARCH_TIMEOUT_MS=500

# Phase 6: Proxy-side admin override that includes stored packets. It never includes ignored or debugger_pending packets.
SOURCE_PROXY_SCOUT_ADMIN_INCLUDE_STORED=0

# Phase 7: Shared HMAC key for Scout promotion finalization.
# SCOUT_PROMOTION_SIGNING_KEY=

# Phase 7: Proxy intake endpoint for approved Scout promotions.
SCOUT_PROMOTION_PROXY_INTAKE_URL=http://localhost:8077/v1/scout-intake/promotion
